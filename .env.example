# Documentation only: set these in your MCP host environment (no automatic dotenv loading).
AUTHEO_DEVHUB_URL=http://127.0.0.1:8786
AUTHEO_HIVE_TEAM=personal
AUTHEO_HIVE_JWT=
AUTHEO_HIVE_API_KEY=
# Public Marketplace application origin (NOT DevHub's private HMAC listener).
AUTHEO_MARKETPLACE_API_URL=
AUTHEO_MARKETPLACE_BEARER_TOKEN=
# Private HMAC bridge; gateway deployments additionally require mTLS files.
AUTHEO_MARKETPLACE_URL=http://127.0.0.1:8786
AUTHEO_MARKETPLACE_HMAC_KEY_ID=
AUTHEO_MARKETPLACE_HMAC_SECRET=
AUTHEO_MARKETPLACE_CA_FILE=
AUTHEO_MARKETPLACE_CERT_FILE=
AUTHEO_MARKETPLACE_KEY_FILE=
AUTHEO_RPC_URL=http://127.0.0.1:26657
AUTHEO_REST_URL=http://127.0.0.1:1317
AUTHEO_EVM_RPC_URL=
AUTHEO_PRICE_FEED_URL=
AUTHEO_ORACLE_URL=http://127.0.0.1:8786
AUTHEO_REQUEST_TIMEOUT=30

# Optional signed agent-environment inspection (install .[trust]).
# All six are required. Paths are operator configuration, never MCP tool arguments.
# Export with the sibling autheo-agent-environment prototype. Snapshot expires in 120s.
AUTHEO_AGENT_TRUST_SNAPSHOT=
AUTHEO_AGENT_TRUST_PUBLIC_KEY=
AUTHEO_AGENT_TRUST_ISSUER=
AUTHEO_AGENT_TRUST_KEY_ID=
AUTHEO_AGENT_TRUST_SUBJECT=
AUTHEO_AGENT_TRUST_ENVIRONMENT=
